<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/checkout.css">
</head>
<body>
<div class="container my-5">

  <!-- Menu Section -->
  <div id="menu-section">
    <h3 class="mb-4">Select Items</h3>
    <div class="row g-3">
      <% drinks.forEach(drink => { %>
        <div class="col-6 col-md-3">
          <div class="card text-center">
            <img src="/images/<%= drink.image %>" class="card-img-top" alt="<%= drink.name %>">
            <div class="card-body">
              <h5 class="card-title"><%= drink.name %></h5>
              <p class="card-text">$<%= drink.price %></p>
              <div class="form-check">
                <input class="form-check-input menu-checkbox" type="checkbox" 
                       id="drink<%= drink._id %>" 
                       data-name="<%= drink.name %>" 
                       data-price="<%= drink.price %>"
                       data-id="<%= drink._id %>">
                <label class="form-check-label" for="drink<%= drink._id %>">Add</label>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button class="btn btn-primary mt-4" id="toCheckout">Next: Checkout</button>
  </div>

  <!-- Checkout Section -->
  <div id="checkout-section" style="display:none;">
    <div class="row g-3">
      <!-- Customer Form -->
      <div class="col-12 col-md-7">
        <div class="card p-3 mb-3">
          <h5>Customer & Shipping</h5>
          <form id="customerForm">
            <div class="mb-3">
              <label class="form-label">Full Name</label>
              <input type="text" class="form-control" id="fullName" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" id="email" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Phone</label>
              <input type="tel" class="form-control" id="phone" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Address</label>
              <input type="text" class="form-control" id="address" required>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label">City</label>
                <input type="text" class="form-control" id="city" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Postal Code</label>
                <input type="text" class="form-control" id="postal" required>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Country</label>
              <select class="form-select" id="country" required>
                <option value="">Choose...</option>
                <option>USA</option>
                <option>UK</option>
                <option>Spain</option>
                <option>Other</option>
              </select>
            </div>

            <!-- Payment -->
            <h5>Payment</h5>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="payment" id="card" checked>
              <label class="form-check-label" for="card">Card</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="payment" id="cod">
              <label class="form-check-label" for="cod">Cash on Delivery</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="payment" id="wallet">
              <label class="form-check-label" for="wallet">Wallet</label>
            </div>

            <div id="cardDetails" class="mt-3">
              <div class="mb-3">
                <label class="form-label">Cardholder Name</label>
                <input type="text" class="form-control" id="cardName">
              </div>
              <div class="mb-3">
                <label class="form-label">Card Number</label>
                <input type="text" class="form-control" id="cardNumber">
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Expiry</label>
                  <input type="text" class="form-control" id="expiry">
                </div>
                <div class="col-md-6">
                  <label class="form-label">CVV</label>
                  <input type="text" class="form-control" id="cvv">
                </div>
              </div>
            </div>

            <div class="form-check my-3">
              <input class="form-check-input" type="checkbox" id="terms">
              <label class="form-check-label" for="terms">I agree to terms & conditions</label>
            </div>

            <button class="btn btn-success w-100" id="placeOrder" disabled>Confirm Order</button>
            <a href="/checkout" class="btn btn-secondary w-100 mt-2">Go Back to Menu</a>
          </form>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="col-12 col-md-5">
        <div class="card p-3 sticky-summary">
          <h5>Order Summary</h5>
          <ul class="list-group mb-3" id="orderSummaryList"></ul>
          <p id="subtotalText">Subtotal: $0.00</p>
          <p id="discountText">Discount: $0.00</p>
          <p id="shippingText">Shipping: $5.00</p>
          <p id="taxText">Tax (10%): $0.00</p>
          <h6 id="grandTotalText">Grand Total: $0.00</h6>

          <div class="input-group mt-3">
            <input type="text" class="form-control" id="couponInput" placeholder="Coupon code">
            <button class="btn btn-outline-secondary" id="applyCoupon">Apply</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden form for backend -->
  <form id="finalOrderForm" action="/order/confirm" method="POST" style="display:none;">
    <input type="hidden" name="itemsJson" id="itemsJson">
    <input type="hidden" name="fullName" id="fullNameInput">
    <input type="hidden" name="email" id="emailInput">
    <input type="hidden" name="phone" id="phoneInput">
    <input type="hidden" name="address" id="addressInput">
    <input type="hidden" name="city" id="cityInput">
    <input type="hidden" name="postal" id="postalInput">
    <input type="hidden" name="country" id="countryInput">
    <input type="hidden" name="coupon" id="couponHidden">
  </form>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
const selectedItems = [];
let discount = 0;

// Update summary
function updateSummary() {
  const subtotal = selectedItems.reduce((sum, item) => sum + item.price, 0);
  const discountAmount = subtotal * discount;
  const taxedSubtotal = subtotal - discountAmount;
  const shipping = 5;
  const tax = taxedSubtotal * 0.1;
  const grandTotal = taxedSubtotal + shipping + tax;

  $('#orderSummaryList').empty();
  selectedItems.forEach(item => {
    $('#orderSummaryList').append(`<li class="list-group-item d-flex justify-content-between">${item.name} <span>$${item.price.toFixed(2)}</span></li>`);
  });

  $('#subtotalText').text(`Subtotal: $${subtotal.toFixed(2)}`);
  $('#discountText').text(`Discount: $${discountAmount.toFixed(2)}`);
  $('#shippingText').text(`Shipping: $${shipping.toFixed(2)}`);
  $('#taxText').text(`Tax (10%): $${tax.toFixed(2)}`);
  $('#grandTotalText').text(`Grand Total: $${grandTotal.toFixed(2)}`);
}

// Menu selection
$('.menu-checkbox').on('change', function() {
  const id = $(this).data('id');
  const name = $(this).data('name');
  const price = parseFloat($(this).data('price'));
  if(this.checked) selectedItems.push({ id, name, price });
  else selectedItems.splice(selectedItems.findIndex(i=>i.id===id),1);

  updateSummary();
  $('#placeOrder').prop('disabled', selectedItems.length===0);
});

// Coupon
$('#applyCoupon').on('click', function() {
  const code = $('#couponInput').val().trim();
  if(code==='SAVE10') { discount = 0.1; alert('Coupon applied! 10% discount.'); }
  else { discount = 0; alert('Invalid coupon.'); }
  updateSummary();
});

// Show checkout
$('#toCheckout').on('click', function() {
  if(selectedItems.length===0){ alert('Select at least one item!'); return; }
  $('#menu-section').hide();
  $('#checkout-section').show();
  updateSummary();
});

// Payment toggle
$('input[name="payment"]').on('change', function() {
  if($('#card').is(':checked')) $('#cardDetails').show();
  else $('#cardDetails').hide();
});

// Place order
$('#placeOrder').on('click', function(e){
  e.preventDefault();
  $('#fullNameInput').val($('#fullName').val());
  $('#emailInput').val($('#email').val());
  $('#phoneInput').val($('#phone').val());
  $('#addressInput').val($('#address').val());
  $('#cityInput').val($('#city').val());
  $('#postalInput').val($('#postal').val());
  $('#countryInput').val($('#country').val());
  $('#itemsJson').val(JSON.stringify(selectedItems));
  $('#couponHidden').val(discount>0?'SAVE10':'');
  $('#finalOrderForm').submit();
});
</script>
</body>
</html>
